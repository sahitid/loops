# Required on Vercel: connect a private Blob store.
BLOB_READ_WRITE_TOKEN=
# Optional until Claude drafting is enabled.
ANTHROPIC_API_KEY=
# Required for organization-wide personal keys.
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Required for scheduled publication.
CRON_SECRET=

# Email sign-in, recurring response forms and newsletters (server only).
# Set gmail to send from your own Gmail account, without a custom domain.
EMAIL_PROVIDER=resend
GMAIL_USER=
# Optional verified Send mail as address. Authentication still uses GMAIL_USER.
GMAIL_FROM_ADDRESS=
# A Google app password, not your regular Google password.
GMAIL_APP_PASSWORD=
# These two are needed only when EMAIL_PROVIDER=resend.
RESEND_API_KEY=
EMAIL_FROM=
APP_URL=https://loops-sand.vercel.app
# Random secret of at least 32 characters; never prefix with NEXT_PUBLIC_.
AUTH_SECRET=
